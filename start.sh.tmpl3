#!/bin/sh
set -eu

# 生成密钥（输出到 stderr，捕获它！）
KEYPAIR=$(/app/sing-box generate reality-keypair 2>&1 >/dev/null)

# 提取（安全方式）
PRIVATE_KEY=$(echo "$KEYPAIR" | sed 's/\x1b\[[0-9;]*m//g' | awk -F': ' '/PrivateKey/ {gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print $2; exit}')
PUBLIC_KEY=$(echo "$KEYPAIR" | sed 's/\x1b\[[0-9;]*m//g' | awk -F': ' '/PublicKey/ {gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print $2; exit}')
SHORT_ID=$(openssl rand -hex 8)
UUID=$(cat /proc/sys/kernel/random/uuid)

# 导出为环境变量（供 envsubst 使用）
export UUID PRIVATE_KEY PUBLIC_KEY SHORT_ID

# 用 envsubst 安全替换模板（自动转义特殊字符！）
envsubst < /app/start.sh.tmpl > /app/start.sh
chmod +x /app/start.sh

# 输出调试信息（安全！）
echo "✅ UUID: $UUID"
echo "✅ Public Key: $(echo $PUBLIC_KEY | cut -c1-20)...[truncated]"
echo "✅ Short ID: $SHORT_ID"
echo "Client: vless://$UUID@yamanote.proxy.rlwyt.net:25247?security=reality&pbk=$(echo $PUBLIC_KEY | sed 's/[&$"]/\\&/g')&sid=$SHORT_ID&sni=sinbox-production.up.railway.app&type=tcp"

exec /app/sing-box run -c /app/config.json
